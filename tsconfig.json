{
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": false,
    "noImplicitThis": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  }
}
